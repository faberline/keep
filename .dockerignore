# Keep the docker build context lean — these are never needed inside an image
# build (a from-source Dockerfile only needs Cargo workspace manifests, lockfile, and crates/).
target/
**/target/
target-linux/
**/target-linux/
target-linux-*/
**/target-linux-*/
.git/
.vat/
**/.vat/
**/*.log
pkg/
**/*.png
data/

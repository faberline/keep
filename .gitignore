# Tool run caches and state written under the cwd; process output, never source.
# Guard waivers (.guard/waivers.json) are source.
.aw/
.meter/
.guard/*
!.guard/waivers.json
.vat/
.local/
.benchmarks/
.baselines/
mutants.out
mutants.out.old

# Per-run scratch left by dispatched agents.
.agents/*
!.agents/agents/
!.agents/skills/
!.agents/plugins/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
.mcp.json

# Environment files.
.env
.env.*
!.env.example

# Editors and OS.
.vscode/
.idea/
*.swp
.DS_Store

# Cargo build output.
/target/

# keep's default data dir when KEEP_DATA_DIR is unset.
/data/
__pycache__/

